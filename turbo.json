{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "NEXT_PUBLIC_API_URL"],
  "globalPassThroughEnv": [
    "PORT",
    "API_PORT",
    "CORS_ORIGINS",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_MODEL",
    "WEB_URL",
    "RESEND_API_KEY",
    "MAIL_FROM",
    "COOKIE_SAMESITE",
    "COOKIE_SECURE",
    "STRIPE_SECRET_KEY",
    "STRIPE_PRICE_ID",
    "STRIPE_WEBHOOK_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "src/generated/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
