# ── Database ─────────────────────────────────────────────
# Local: postgresql://postgres:postgres@localhost:5432/holdline
# Railway: reference ${{Postgres.DATABASE_URL}} on each service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/holdline

# ── API ──────────────────────────────────────────────────
API_PORT=4000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ── Web ──────────────────────────────────────────────────
# Browser-visible base URL of the API
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── AI (plain-English -> BidIntent parsing) ──────────────
# console.anthropic.com -> API Keys. Only the API reads this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
