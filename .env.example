# ── Database ─────────────────────────────────────────────
# Local: postgresql://postgres:postgres@localhost:5432/holdline
# Railway: reference ${{Postgres.DATABASE_URL}} on each service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/holdline

# ── API ──────────────────────────────────────────────────
API_PORT=4000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ── Web ──────────────────────────────────────────────────
# Browser-visible base URL of the API
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── AI (plain-English -> BidIntent parsing) ──────────────
# console.anthropic.com -> API Keys. Only the API reads this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Accounts (magic-link sign-in) ───────────────────────
# Web app base URL, used in sign-in emails and Stripe redirects
WEB_URL=http://localhost:3000
# resend.com -> API Keys. Without it, development prints sign-in links to the API console
# and production answers 503.
RESEND_API_KEY=
MAIL_FROM=Holdline <signin@example.com>
# Session cookie. Web and API on different sites need COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ── Billing (Stripe subscription) ────────────────────────
# dashboard.stripe.com -> Developers. All three, or billing answers 503.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
